# Copy this file to ".env" (same folder) and fill in your own values.

# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/roadies-rebirth
# Atlas (free cloud):  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/roadies-rebirth
MONGODB_URI=mongodb://127.0.0.1:27017/roadies-rebirth

# Secret password for the /admin page. Use at least 12 characters. Keep it private.
ADMIN_KEY=change-me-to-a-long-secret

# Port for the server
PORT=5000

# Your live website address (no trailing slash). Used for the sitemap and Google tags.
# Example: https://roadies-rebirth.onrender.com
SITE_URL=http://localhost:5000
